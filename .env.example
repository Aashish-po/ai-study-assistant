# Backend API (Vercel)
EXPO_PUBLIC_API_BASE_URL=https://studybuddy-api.vercel.app

# OAuth (same backend, different route)
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://studybuddy-api.vercel.app/oauth
EXPO_PUBLIC_OAUTH_SERVER_URL=https://studybuddy-api.vercel.app

# App identity (YOU define this once)
EXPO_PUBLIC_APP_ID=studybuddy

# Owner (get OPEN_ID after first login)
EXPO_PUBLIC_OWNER_OPEN_ID=will_be_filled_after_admin_login
EXPO_PUBLIC_OWNER_NAME=Aashish Paudel

# Deep linking scheme
EXPO_PUBLIC_APP_SCHEME=studybuddy

# Expo web (only if using web)
EXPO_WEB_PREVIEW_URL=https://studybuddy.vercel.app
