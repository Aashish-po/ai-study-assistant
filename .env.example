# Client-side (Expo)
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com
EXPO_PUBLIC_OAUTH_SERVER_URL=https://your-oauth-server.example.com
EXPO_PUBLIC_APP_ID=your_app_id
EXPO_PUBLIC_OWNER_OPEN_ID=owner_open_id
EXPO_PUBLIC_OWNER_NAME=Owner Name
EXPO_PUBLIC_APP_SCHEME=studybuddy

# Server-side (Vercel)
# Keep EXPO_PUBLIC_APP_ID and VITE_APP_ID in sync.
VITE_APP_ID=your_app_id
JWT_SECRET=replace_me
DATABASE_URL=mysql://user:pass@host:3306/db
OAUTH_SERVER_URL=https://your-oauth-server.example.com
OWNER_OPEN_ID=owner_open_id
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=replace_me

# Optional: OAuth redirect for Expo web
EXPO_WEB_PREVIEW_URL=https://your-expo-web.example.com
